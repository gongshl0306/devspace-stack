# Secrets — never commit
.env

# DevSpace runtime state (SQLite DB, OAuth tokens, workspace sessions)
devspace-config/skills/
devspace-config/agents/
devspace-config/*.db
devspace-config/*.sqlite*

# Local code workspace (usually has its own VCS)
workspace/*
!workspace/.gitkeep

# cloudflared per-machine config (generated by setup-tunnel.sh from
# config.yml.example — the template is committed, the generated file is not)
cloudflared/config.yml
cloudflared/*.json
cloudflared/*.cert

# Static Bearer token for clients without OAuth support (generated)
.mcp-bearer-token
