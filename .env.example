# =============================================================================
# DevSpace stack — environment
#
# Copy to .env and fill in the values:
#   cp .env.example .env
#
# .env is git-ignored. It contains secrets — do not commit it.
# =============================================================================

# --- DevSpace ----------------------------------------------------------------

# Owner password for the MCP OAuth approval flow.
# Must be at least 16 characters. Generate one with:
#   openssl rand -base64 32
# Keep it private — anyone with it can approve MCP clients.
DEVSPACE_OAUTH_OWNER_TOKEN=change-me-to-a-long-random-secret

# Public HTTPS origin of the tunnel, WITHOUT /mcp.
# This is the hostname you route to the tunnel in Cloudflare DNS, e.g.:
#   https://devspace.example.com
# DevSpace derives its Host-header allowlist from this value.
DEVSPACE_PUBLIC_BASE_URL=https://devspace.example.com

# --- Cloudflare Tunnel -------------------------------------------------------
#
# The tunnel runs in *named-tunnel* mode (credentials-file), not token mode.
# Its two inputs are files, not .env variables:
#
#   cloudflared/config.yml        — ingress rules (hostname -> service).
#                                   Generated by setup-tunnel.sh from
#                                   config.yml.example; git-ignored.
#   cloudflared/credentials.json  — TunnelID + TunnelSecret.
#                                   Git-ignored; created by setup-tunnel.sh.
#
# The cloudflared container must run as the host user that owns
# credentials.json (so it can read the 600-permission file). Set these to
# your host UID:GID — check with `id -u` and `id -g` on the machine that ran
# setup-tunnel.sh. Defaults to 1000:1000.
CLOUDFLARED_UID=1000
CLOUDFLARED_GID=1000

# Access token lifetime in seconds (default 3600 = 1h).
# If your MCP client only supports a static Bearer token (no OAuth flow),
# set this very long (e.g. 31536000 = 1 year), obtain a token once via the
# OAuth flow, and paste it into the client's Bearer field.
DEVSPACE_OAUTH_ACCESS_TOKEN_TTL_SECONDS=31536000

# --- Docker build ------------------------------------------------------------

# Debian mirror used while building the image (Dockerfile ARG APT_MIRROR).
# Leave unset for the official deb.debian.org. If apt is very slow from your
# network (common from China), point it at a local mirror. Use http:// and
# host-only (no /debian path): the base image has no ca-certificates installed
# when apt runs, so https fails; the sed keeps the sources' own path.
#   APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn
#APT_MIRROR=http://deb.debian.org

# npm registry used while building the image (Dockerfile ARG NPM_REGISTRY).
# Leave unset for the official registry.npmjs.org; if slow from your network:
#   NPM_REGISTRY=https://registry.npmmirror.com
#NPM_REGISTRY=https://registry.npmjs.org

# Compile native modules (better-sqlite3, node-pty) with the build toolchain
# instead of fetching prebuilt binaries from GitHub releases. Set true when
# that download is slow or hangs on your network. Default false.
#BUILD_FROM_SOURCE=false
